# Admin UI: /admin?k=<ANON_ADMIN_PASS>. Leave empty to disable the admin UI.
ANON_ADMIN_PASS=change-me-to-a-long-random-string

# Key for /api/monitor/activity?key=... Leave empty to disable.
ANON_MONITOR_KEY=

# Limits
ANON_MAX_MB=80
ANON_RESULT_TTL=1800
ANON_SESSION_TTL=43200

# Set to 0 for local HTTP testing; keep 1 behind HTTPS.
ANON_COOKIE_SECURE=1
# Set to 1 only when running behind a reverse proxy that sets X-Forwarded-For.
ANON_TRUST_PROXY=0

# Name shown in the UI footer and landing page.
ANON_BRAND=PII Anonymizer
# Used by manage.py to print full access links.
ANON_PUBLIC_URL=http://localhost:8000

# OCR tuning
ANON_OCR_LANG=deu+eng
ANON_OCR_MIN_CONF=35
ANON_SCAN_DPI=200
ANON_OCR_MIN_WIDTH=1700

# Optional LLM assist (any OpenAI-compatible endpoint). Only used when the user ticks the box.
ANON_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
ANON_LLM_API_KEY=
ANON_LLM_MODEL=gemini-2.5-flash-lite
